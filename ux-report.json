 "rules": [
  {
   "id": "haeyo",
   "level": "must",
   "title": "해요체로 통일",
   "guide": "제품 안의 모든 문구는 해요체로 써요."
  },
  {
   "id": "doeeoyo",
   "level": "must",
   "title": "\"되어요\"는 \"돼요\"로",
   "guide": "\"되어요\"는 모두 \"돼요\"로 통일해요."
  },
  {
   "id": "dialog-cancel",
   "level": "must",
   "title": "대화상자 왼쪽 버튼은 \"닫기\"",
   "guide": "\"취소\"는 진행 중인 작업이 취소된다고 오해할 수 있어, 다이얼로그 왼쪽 버튼은 \"닫기\"로 통일해요."
  },
  {
   "id": "honorific",
   "level": "should",
   "title": "과한 경어 쓰지 않기",
   "guide": "\"~시겠어요?\", \"~시나요?\", \"~께\" 같은 과한 경어 대신 친근한 말투로 써요.",
   "exceptions": "사용자 맥락으로 질문하거나 상황을 추정할 때, 설문처럼 선의가 필요할 때는 경어를 써도 돼요."
  },
  {
   "id": "passive",
   "level": "should",
   "title": "능동형으로 말하기",
   "guide": "수동형은 특정 상황에서만 써요. \"됐어요\" → \"했어요\".",
   "exceptions": "서비스 종료·기간 만료, 사용자 영향 설명(해지·적용), 민감한 정보 수집 안내는 수동형도 돼요."
  },
  {
   "id": "negative",
   "level": "should",
   "title": "긍정형으로 말하기",
   "guide": "부정 표현을 줄이고 \"~하면 할 수 있어요\"로 써요. \"없어요\" → \"있어요\".",
   "exceptions": "정책상 쓸 수 없을 때(이유와 함께), 일부 기능만 못 쓸 때, 민감한 정보 수집 안내는 부정형도 돼요."
  }
 ],
